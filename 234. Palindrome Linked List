void push(int val,int* top,int* stack)
{
    *top=*top+1;
    stack[*top]=val;
}
int pop(int* top,int* stack)
{
    int val=stack[*top];
    *top=*top-1;
    return val;
}
bool isPalindrome(struct ListNode* head) {
    int i,n=0;
    struct ListNode* temp=head;
    while (temp!=NULL)
    {
        n=n+1;
        temp=temp->next;
    }
    int top=-1,stack[n];
    temp=head;
    for (i=0;i<((n/2)+(n%2));i++)
    {
        push(temp->val,&top,stack);
        if ((n%2==0)||((n%2==1)&&((i+1)<((n/2)+(n%2)))))
            temp=temp->next;
    }
    while (temp!=NULL)
    {
        if (temp->val!=pop(&top,stack))
            return false;
        temp=temp->next;
    }
    return true;
}
