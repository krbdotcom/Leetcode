#include <limits.h>
int myAtoi(char* s) {
    long int n=0,a=0,d=0;
    while (*s!='\0')
    {
        if ((*s==' ')&&(d==0)&&(a==0))
        {
            s=s+1;
            continue;
        }
        else if ((*s=='-')&&(d==0)&&(a==0))
            a=-1;
        else if ((*s=='+')&&(d==0)&&(a==0))
            a=1;
        else if (*s>=48&&*s<=57)
        {
            d=1;
            n=n*10+(*s-'0');
            if ((n>INT_MAX)||(-n<INT_MIN))
            {
                if (a==1)
                    return INT_MAX;
                else if (a==-1)
                    return INT_MIN;
                else
                    return INT_MAX;
            }
        }
        else
            break;
        s=s+1;
    }
    if (a==1)
        return n;
    else if (a==-1)
        return -n;
    else
        return n;
}
