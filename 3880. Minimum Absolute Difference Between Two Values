int minAbsoluteDifference(int* nums, int numsSize) {
    int i,j,s=0,diff=numsSize;;
    for (i=0;i<numsSize;i++)
    {
        if (nums[i]==1)
        {
            if ((diff>(i-j))&&(s==2))
                diff=(i-j);
            j=i;
            s=1;
        }
        else if (nums[i]==2)
        {
            if ((diff>(i-j))&&(s==1))
                diff=(i-j);
            j=i;
            s=2;
        }
    }
    if (diff==numsSize)
        return -1;
    else
        return diff;
}
