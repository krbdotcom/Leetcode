char* mergeAlternately(char* word1, char* word2) {
    int i,j=0,l1=strlen(word1),l2=strlen(word2),l=(l1>l2)?l2:l1,a=(l1>l2)?1:2;
    char* str=(char*)malloc((l1+l2+1)*sizeof(char));
    for (i=0;i<(2*l);i++)
    {
        switch (i%2)
        {
            case 0:
            {
                str[i]=word1[j];
                break;
            }
            case 1:
            {
                str[i]=word2[j];
                j=j+1;
                break;
            }
        }
    }
    if (a==1)
    {
        while (j<l1)
        {
            str[i]=word1[j];
            i=i+1,j=j+1;
        }
    }
    else
    {
        while (j<l2)
        {
            str[i]=word2[j];
            i=i+1,j=j+1;
        }
    }
    str[i]='\0';
    return str;
}
