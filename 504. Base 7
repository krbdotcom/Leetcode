char* convertToBase7(int num) {
    int i,j,count=0;
    char* str=(char*)malloc(20*sizeof(char));
    if (num==0)
        return "0";
    else if (num<0)
    {
        j=-1;
        num=-(num);
    }
    else
        j=1;
    while (num>0)
    {
        i=num%7;
        char s=i+'0';
        str[count]=s;
        count=count+1;
        num=num/7;
    }
    if (j==-1)
        str[count]='-';
    else if (j==1)
        count=count-1;
    str[count+1]='\0';
    i=0;
    while (i<count)
    {
        char s=str[i];
        str[i]=str[count];
        str[count]=s;
        i=i+1;
        count=count-1;
    }
    return str;
}
