int rotatedDigits(int n) {
    int i,j,x,c=0,s=0,a=0;
    for (i=1;i<=n;i++)
    {
        bool t=true;
        x=i;
        while (x/((int)pow(10,c))!=0)
            c=c+1;
        while ((c-1)>=0)
        {
            j=(x/(int)pow(10,c-1))%10;
            if ((j==3)||(j==4)||(j==7))
            {
                t=false;
                break;
            }
            else
            {
                switch (j)
                {
                    case 2:
                    {
                        s=s*10+5;
                        break;
                    }
                    case 5:
                    {
                        s=s*10+2;
                        break;
                    }
                    case 6:
                    {
                        s=s*10+9;
                        break;
                    }
                    case 9:
                    {
                        s=s*10+6;
                        break;
                    }
                    default:
                    {
                        s=s*10+j;
                        break;
                    }
                }
            }
            c=c-1;
        }
        if ((t==true)&&(s!=i))
            a=a+1;
        s=0;
        c=0;
    }
    return a;
}
