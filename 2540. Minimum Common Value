int getCommon(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    int i=0,j=0,a=0,s;
    while ((i<nums1Size)&&(j<nums2Size))
    {
        if (nums1[i]==nums2[j])
        {
            if (a==0)
                s=nums1[i];
            else if (s>nums1[i])
                s=nums1[i];
            a=1;
            i=i+1;
            j=j+1;
        }
        else if (nums1[i]>nums2[j])
            j=j+1;
        else if (nums1[i]<nums2[j])
            i=i+1;
    }
    if (a==1)
        return s;
    else
        return -1;
}
