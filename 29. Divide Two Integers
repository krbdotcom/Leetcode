int divide(int dividend, int divisor) {
    long int i,s=0,a=0,divd=dividend,divs=divisor;
    if (dividend==0)
        return 0;
    else if (dividend==divisor)
        return 1;
    else if (divisor==1)
        return dividend;
    else if (divisor==-1)
        return (INT_MIN==dividend?INT_MAX:-dividend);
    if (dividend>0)
    {
        while (s<=divd)
        {
            a=a+1;
            if (divisor>0)
                s=s+divs;
            if (divisor<0)
                s=s-divs;
        }
    }
    if (dividend<0)
    {
        while (s<=(-divd))
        {
            a=a+1;
            if (divisor>0)
                s=s+divs;
            if (divisor<0)
                s=s-divs;
        }
    }
    if ((divisor>0&&dividend>0)||(divisor<0&&dividend<0))
        return a-1;
    else
        return -(a-1);
}
