int* concatWithReverse(int* nums, int n, int* returnSize) {
    int i;
    int* ans=(int*)malloc((2*n)*sizeof(int));
    for (i=0;i<(2*n);i++)
    {
        if (i<n)
            ans[i]=nums[i];
        else if (i>=n)
            ans[i]=nums[(n-(i-n))-1];
    }
    *returnSize=2*n;
    return ans;
}
