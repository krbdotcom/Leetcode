int minElement(int* nums, int numsSize) {
    int i,j,x,h,s=0;
    for (i=0;i<numsSize;i++)
    {
        s=0,x=nums[i];
        while (x>0)
        {
            j=x%10;
            s=s+j;
            x=x/10;
        }
        if (i==0)
            h=s;
        else if ((i!=0)&&(h>s))
            h=s;
    }
    return h;
}
