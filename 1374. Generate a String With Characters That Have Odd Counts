char* generateTheString(int n){
    int i;
    char* str=(char*)malloc(n*sizeof(int));
    switch (n%2)
    {
        case 1:
        {
            for (i=0;i<n;i++)
                str[i]='f';
            str[i]='\0';
            break;
        }
        default:
        {
            for (i=0;i<(n-1);i++)
                str[i]='f';
            str[i]='k';
            str[i+1]='\0';
            break;
        }
    }
    return str;
}
