bool detectCapitalUse(char* word) {
    int i,c=0,n=0;
    int l=strlen(word);
    if ((*word>=65)&&(*word<=90))
        i=1;
    else
        i=0;
    word=word+1;
    while (*word!='\0')
    {
        if ((*word>=65)&&(*word<=90))
            c=c+1;
        else
            n=n+1;
        word=word+1;
    }
    if (((i==1)&&(c==(l-1)))||((i==1)&&(n==(l-1)))||((i==0)&&(n==(l-1))))
        return true;
    else
        return false;
}
