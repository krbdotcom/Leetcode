char* reverseVowels(char* s) {
    int i=0,j=0,k=0;
    int l=strlen(s)-1;
    while (i<l)
    {
        if ((j==0)||(k==0))
        {
            if ((s[i]!='A')&&(s[i]!='E')&&(s[i]!='I')&&(s[i]!='O')&&(s[i]!='U')&&(s[i]!='a')&&(s[i]!='e')&&(s[i]!='i')&&(s[i]!='o')&&(s[i]!='u'))
                i=i+1;
            else
                j=1;
            if ((s[l]!='A')&&(s[l]!='E')&&(s[l]!='I')&&(s[l]!='O')&&(s[l]!='U')&&(s[l]!='a')&&(s[l]!='e')&&(s[l]!='i')&&(s[l]!='o')&&(s[l]!='u'))
                l=l-1;
            else
                k=1;
        }
        else if ((j==1)&&(k==1))
        {
            char rev=s[i];
            s[i]=s[l];
            s[l]=rev;
            j=0,k=0,i=i+1,l=l-1;
        }
    }
    return s;
}
