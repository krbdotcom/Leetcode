int compareVersion(char* version1, char* version2) {
    int s1=0,s2=0;
    while ((*version1!='\0')||(*version2!='\0'))
    {
        if ((*version1!='\0')&&(*version1!='.'))
        {
            s1=s1*10+(*version1-'0');
            version1=version1+1;
        }
        if ((*version2!='\0')&&(*version2!='.'))
        {
            s2=s2*10+(*version2-'0');
            version2=version2+1;
        }
        if (((*version1=='\0')||(*version1=='.'))&&((*version2=='\0')||(*version2=='.')))
        {
            if (s1>s2)
                return 1;
            else if (s1<s2)
                return -1;
            s1=0;
            s2=0;
            if (*version1=='.')
                version1=version1+1;
            if (*version2=='.')
                version2=version2+1;
        }
    }
    return 0;
}
