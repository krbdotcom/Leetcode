int countKeyChanges(char* s) {
    int a,n=0;
    char i=*s;
    a=casecheck(i);
    while (*s!='\0')
    {
        if (a==0)
        {
            if ((*s!=i)&&(*s!=(i+32)))
                n=n+1;
        }
        else if (a==1)
        {
            if ((*s!=i)&&(*s!=(i-32)))
                n=n+1;
        }
        i=*s;
        a=casecheck(i);
        s=s+1;
    }
    return n;
}
int casecheck(char i)
{
    int a;
    if ((i>=65)&&(i<=90))
        a=0;
    else if ((i>=97)&&(i<=122))
        a=1;
    return a;
}
