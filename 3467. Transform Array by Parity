int* transformArray(int* nums, int numsSize, int* returnSize) {
    int i,e=0,o=0;
    int* ans=(int*)malloc(numsSize*sizeof(int));
    for (i=0;i<numsSize;i++)
    {
        if (nums[i]%2==0)
            e=e+1;
        else
            o=o+1;
    }
    for (i=0;i<numsSize;i++)
    {
        if (e>0)
        {
            ans[i]=0;
            e=e-1;
        }
        else if ((e==0)&&(o>0))
        {
            ans[i]=1;
            o=o-1;
        }
    }
    *returnSize=numsSize;
    return ans;
}
