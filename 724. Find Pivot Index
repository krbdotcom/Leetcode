int pivotIndex(int* nums, int numsSize) {
    int i,s1=0,s2=0;
    for (i=1;i<numsSize;i++)
        s1=s1+nums[i];
    if (s1==0)
        return 0;
    else
    {
        for (i=1;i<numsSize;i++)
        {
            s2=s2+nums[i-1];
            s1=s1-nums[i];
            if (s1==s2)
                return i;
        }
    }
    return -1;
}
