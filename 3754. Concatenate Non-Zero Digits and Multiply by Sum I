long long sumAndMultiply(int n) {
    int i=1;
    long long s=0,x=0;
    while (n>0)
    {
        if ((n%10)!=0)
        {
            s=s+(n%10);
            if (x==0)
                x=(n%10);
            else
            {
                x=x+((n%10)*((int)pow(10,i)));
                i=i+1;
            }
        }
        n=n/10;
    }
    return (x*s);
}
