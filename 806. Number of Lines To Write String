int* numberOfLines(int* widths, int widthsSize, char * s, int* returnSize){
    int i,l=0,pix=0;
    int* result=(int*)malloc(2*sizeof(int));
    while (*s!='\0')
    {
        i=(int)*s;
        pix=pix+widths[i-97];
        if (pix>=100)
        {
            if ((pix==100)&&(*(s+1)!='\0'))
                l=l+1;
            else if ((pix==100)&&(*(s+1)=='\0'))
                break;
            else if (pix>100)
            {
                l=l+1;
                s=s-1;
            }
            pix=0;
        }
        s=s+1;
    }
    result[0]=l+1;
    result[1]=pix;
    *returnSize=2;
    return result;
}
