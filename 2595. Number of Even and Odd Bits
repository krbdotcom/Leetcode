int* evenOddBit(int n, int* returnSize) {
    int i,x,c=0,e=0,o=0;
    int* ans=(int*)malloc(2*sizeof(int));
    while (x>0)
    {
        c=c+1;
        x/2;
    }
    while (n>0)
    {
        i=n%2;
        if ((i==1)&&(c%2==0))
            e=e+1;
        else if ((i==1)&&(c%2!=0))
            o=o+1;
        c=c-1;
        n=n/2;
    }
    ans[0]=e;
    ans[1]=o;
    *returnSize=2;
    return ans;
}
