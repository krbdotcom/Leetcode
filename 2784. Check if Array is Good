bool isGood(int* nums, int numsSize) {
    int i,j,n=0,s=0;
    for (i=0;i<numsSize;i++)
    {
        if (nums[i]>n)
            n=nums[i];
    }
    if (numsSize!=(n+1))
        return false;
    else
    {
        for (i=1;i<numsSize;i++)
        {
            for (j=0;j<numsSize;j++)
            {
                if (nums[j]==i)
                    s=s+1;
            }
            if (((i!=n)&&(s!=1))||((i==n)&&(s!=2)))
                return false;
            s=0;
        }
    }
    return true;
}
