bool isGood(int* nums, int numsSize) {
    int i,n=0;
    for (i=0;i<numsSize;i++)
    {
        if (nums[i]>n)
            n=nums[i];
    }
    if (numsSize!=(n+1))
        return false;
    else if (numsSize==(n+1))
    {
        int x=1,s=0;
        for (i=0;i<numsSize;i++)
        {
            if ((nums[i]==x)&&(x==n))
                s=s+1;
            if (((i+1)==numsSize)&&(s!=2)&&(x==n))
                return false;
            else if ((s==2)&&(x==n))
                break;
            if ((nums[i]==x)&&(x!=n))
                s=s+1;
            if (((i+1)==numsSize)&&(s!=1)&&(x!=n))
                return false;
            else if ((s==1)&&(x!=n))
            {
                s=0;
                x=x+1;
                i=-1;
            }
        }
    }
    return true;
}
