int* resultArray(int* nums, int numsSize, int* returnSize) {
    int i,a1,a2,j1=1,j2=1;
    int* arr1=(int*)malloc(numsSize*sizeof(int));
    int* arr2=(int*)malloc(numsSize*sizeof(int));
    for (i=0;i<numsSize;i++)
    {
        if (i==0)
        {
            a1=nums[i];
            arr1[0]=nums[i];
            j1=j1+1;
        }
        else if (i==1)
        {
            a2=nums[i];
            arr2[0]=nums[i];
            j2=j2+1;
        }
        else
        {
            if (a1>a2)
            {
                a1=nums[i];
                arr1[j1-1]=nums[i];
                j1=j1+1;
            }
            else
            {
                a2=nums[i];
                arr2[j2-1]=nums[i];
                j2=j2+1;
            }
        }
    }
    int* arr=(int*)malloc(numsSize*sizeof(int));
    memcpy(arr,arr1,(j1-1)*sizeof(int));
    memcpy(arr+(j1-1),arr2,(j2-1)*sizeof(int));
    free(arr1);free(arr2);
    *returnSize=numsSize;
    return arr;
}
