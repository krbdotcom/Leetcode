int gcd (int a, int b)
{
    if (b==0)
        return a;
    else
        return gcd(b,a%b);
}
int findGCD(int* nums, int numsSize) {
    int i,l=0,s=*nums;
    for (i=0;i<numsSize;i++)
    {
        if (nums[i]<s)
            s=nums[i];
        if (nums[i]>l)
            l=nums[i];
    }
    return gcd(s,l);
}
