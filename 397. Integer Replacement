int integerReplacement(int n) {
    int s=0;
    while (n!=1)
    {
        if (n%2==0)
            n=n/2;
        else
        {
            if (n!=INT_MAX)
            {
                if (((n-1)/2)%2==0)
                    n=n-1;
                else if (n==3)
                    n=n-1;
                else
                    n=n+1;
            }
            else
            {
                n=n-1;
                n=n/2;
            }
        }
        s=s+1;
    }
    return s;
}
