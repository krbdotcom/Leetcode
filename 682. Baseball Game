int top=-1,stack[1000];
void push(int val)
{
    top=top+1;
    stack[top]=val;
}
int pop()
{
    int val=stack[top];
    top=top-1;
    return val;
}
int calPoints(char** operations, int operationsSize)
{   
    int i,j,s=0;
    for (i=0;i<operationsSize;i++)
    {
        switch(*operations[i])
        {
            case '+':
            {
                push(stack[top]+stack[top-1]);
                break;
            }
            case 'D':
            {
                push(stack[top]*2);
                break;
            }
            case 'C':
            {
                pop();
                break;
            }
            default:
                push(atoi(operations[i]));
        }
    }
    while (top!=-1)
        s=s+pop();
    return s;
}
