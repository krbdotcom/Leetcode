struct ListNode* reverseList(struct ListNode* head) {
    if ((head==NULL)||(head->next==NULL))
        return head;
    struct ListNode* temp=head,*curr=head,*prev=head;
    temp=temp->next;
    while (temp!=NULL)
    {
        curr=temp;
        temp=temp->next;
        curr->next=prev;
        prev=curr;
    }
    head->next=NULL;
    head=curr;
    return head;
}
