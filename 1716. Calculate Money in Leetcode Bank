int totalMoney(int n) {
    int i,j=0,s=0;
    for (i=1;i<=n;i++)
    {
        switch (i%7)
        {
            case 0:
            {
                s=s+(7+j);
                break;
            }
            case 1:
            {
                if (i!=1)
                    j=j+1;
                s=s+(1+j);
                break;
            }
            default:
            {
                s=s+((i%7)+j);
                break;
            }
        }
    }
    return s;
}
