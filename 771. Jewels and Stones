int numJewelsInStones(char* jewels, char* stones) {
    int i=0,s=0;
    while (*stones!='\0')
    {
        if (*stones==jewels[i])
        {
            s=s+1;
            stones=stones+1;
            i=0;
        }
        else if ((*stones!=jewels[i])&&(jewels[i+1]=='\0'))
        {
            stones=stones+1;
            i=0;
        }
        else if (*stones!=jewels[i])
            i=i+1;
    }
    return s;
}
