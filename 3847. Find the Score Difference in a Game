int scoreDifference(int* nums, int numsSize) {
    int i,a=1,p1=0,p2=0;
    for (i=0;i<numsSize;i++)
    {
        if ((nums[i]%2!=0)^((i+1)%6==0))
        {
            if (a==1)
                a=2;
            else if (a==2)
                a=1;
        }
        switch (a)
        {
            case 1:
            {
                p1=p1+nums[i];
                break;
            }
            case 2:
            {
                p2=p2+nums[i];
                break;
            }
        }
    }
    return (p1-p2);
}
