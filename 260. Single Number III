int* singleNumber(int* nums, int numsSize, int* returnSize) {
    int i,j=0;
    for (i=0;i<numsSize;i++)
    {
        if ((nums[i]==nums[j])&&(i!=j))
        {
            j=j+1;
            i=-1;
        }
    }
    int x=nums[j];
    nums[j]=0;
    int y=0;
    for (i=0;i<numsSize;i++)
    {
        y=y^nums[i];
    }
    int* result=(int*)malloc(2*sizeof(int));
    result[0]=x;
    result[1]=y;
    *returnSize=2;
    return result;
}
