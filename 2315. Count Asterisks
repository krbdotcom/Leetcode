int countAsterisks(char* s) {
    int ast=0,c=0;
    while (*s!='\0')
    {
        switch (*s)
        {
            case '|':
            {
                (c==0)?(c=1):(c=0);
                break;
            }
            case '*':
            {
                if (c==0)
                    ast=ast+1;
                break;
            }
        }
        s=s+1;
    }
    return ast;
}
