int strStr(char* haystack, char* needle) {
    int i,j=0,z=0,c=0;
    while (needle[c]!='\0')
        c=c+1;
    for (i=0;haystack[i]!='\0';i++)
    {
        if ((haystack[i]==needle[j])&&(j==0)&&(needle[j]!='\0'))
        {
            j=j+1;
            z=i;
        }
        else if ((haystack[i]==needle[j])&&(j>0)&&(needle[j]!='\0'))
            j=j+1;
        else if ((needle[j]!=haystack[i])&&(j>0)&&(needle[j]!='\0'))
        {
            i=i-j;
            j=0;
        }
        else if (needle[j]=='\0')
            break;
    }
    if (j==c)
        return z;
    else
        return -1;
}
